# Mwenza's MCP server for a DeerFlow that runs in Docker. Build context: backend/ (see docker-compose.deerflow.yml).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[mcp]"

# No authentication: reachable only on the DeerFlow compose network, never publish this port on the host.
EXPOSE 8766
USER nobody
CMD ["python", "-m", "mwenza_engine.mcp_server", "--transport", "http", "--host", "0.0.0.0", "--port", "8766", "--allowed-host", "mwenza-mcp"]
