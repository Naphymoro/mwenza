# Mwenza's research image: the one environment student analyses run in. Every run's capsule records this image's
# digest, so a result can be re-run in exactly the same environment. Rebuilding gives a new digest; old capsules
# keep naming the image they ran on.
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends r-base-core r-cran-dplyr r-cran-readr r-cran-tidyr r-cran-ggplot2 \
      r-cran-lme4 r-cran-survival r-cran-psych r-cran-jsonlite \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pandas==2.2.3 numpy==2.1.3 scipy==1.14.1 statsmodels==0.14.4 pingouin==0.5.5 \
      lifelines==0.30.0 matplotlib==3.9.2 openpyxl==3.1.5

ENV MPLBACKEND=Agg PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /work
USER 65534:65534
